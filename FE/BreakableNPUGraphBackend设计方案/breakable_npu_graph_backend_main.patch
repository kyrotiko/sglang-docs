+"""NPU segment graphs using the existing breakable graph protocol."""
+
+from contextlib import contextmanager
+
+from sglang.srt.distributed.device_communicators.pynccl_allocator import set_graph_pool_id
+from sglang.srt.environ import envs
+from sglang.srt.model_executor.runner_backend.breakable_cuda_graph_backend import (
+    BreakableCudaGraphBackend,
+)
+from sglang.srt.runtime_context import get_flags, get_parallel
+
+
+class BreakableNPUGraphBackend(BreakableCudaGraphBackend):
+    def __init__(
+        self,
+        cuda_graph_runner,
+        *,
+        enable_memory_saver=False,
+        debug_eager=False,
+    ):
+        model_runner = cuda_graph_runner.model_runner
+        if model_runner.model_config.hf_config.model_type != "deepseek_v41":
+            raise NotImplementedError("This first NPU prefill profile targets DSV4.1")
+        if model_runner.is_draft_worker or not model_runner.spec_algorithm.is_none():
+            raise ValueError("Disable speculative decoding for the first NPU prefill profile")
+        parallel = get_parallel()
+        if (
+            parallel.pp_size != 1
+            or parallel.attn_dp_size != 1
+            or parallel.attn_cp_size != 1
+            or parallel.attn_dcp_size != 1
+            or parallel.moe_ep_size != 1
+        ):
+            raise ValueError("The first NPU prefill profile uses TP only")
+        if get_flags().capture.enable_torch_compile:
+            raise ValueError("NPU breakable prefill does not support torch.compile")
+        if envs.SGLANG_ENABLE_GRAPH_POOL_PRECARVE.get():
+            raise ValueError("CUDA graph pool precarve is not supported on NPU")
+        if envs.SGLANG_NPU_USE_MULTI_STREAM.get():
+            raise ValueError("Disable NPU multi-stream for the first prefill profile")
+        super().__init__(
+            cuda_graph_runner,
+            enable_memory_saver=enable_memory_saver,
+            debug_eager=debug_eager,
+        )
+
+    @contextmanager
+    def capture_session(self, stream):
+        if self._graphs:
+            raise RuntimeError("Call cleanup before recapturing NPU prefill graphs")
+        if self._pool is None:
+            self._pool = self._device_module.graph_pool_handle()
+        set_graph_pool_id(self._pool)
+        self._capture_stream = stream
+        self._shared_output_buffer = None
+        self.deduped_cuda_graph = None
+        try:
+            with self.replay_session():
+                yield
+        finally:
+            self._capture_stream = None
